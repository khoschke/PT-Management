# Copy this file to .env.local for local development, and set the same
# values in your Vercel project settings for deployment.

# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Used to salt IP address hashes for rate limiting,
# so raw IP addresses are never stored.
IP_HASH_SALT=

# Optional. Leave blank to run without email, the dashboard works fully
# without it. Set both to turn on trainer allocation emails and the manager
# daily digest.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=

# Email address the 7am daily digest is sent to.
PT_MANAGER_EMAIL=

# Shared secret checked by the daily digest cron endpoint, so it can't be
# triggered by anyone who finds the URL. Vercel Cron sends this automatically
# once set in vercel.json / project settings.
CRON_SECRET=
